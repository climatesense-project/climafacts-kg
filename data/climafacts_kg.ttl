:claimreview_9db206b2636e2b67b13359a78832693b a schema:ClaimReview ;
    owl:sameAs :claimreview_185290c06f995251914ee55fa4f7837a ;
    schema:author :person_b2a6c6df95c32fa2357c41df1b2e1920 ;
    schema:claimReviewed :claimreview_185290c06f995251914ee55fa4f7837a ;
    schema:headline "L’anno 1934 fu l’anno più caldo negli USA (che rappresentano il 2% del globo). Secondo la NASA il record di temperatura globale appartiene all’anno 2005."@it ;
    schema:inLanguage "Italian"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "L’anno1934 fu il più caldo del periodo recente"@it ;
    schema:publisher :organization_sks ;
    schema:reviewBody "La figura 1 mostra i due trends prima e dopo l’aggiustamento. Prima che si scoprisse l’errore il trend era di 0.185°C per decennio. Dopo la correzione il trend era ancora 0.185°C per decennio. La differenza della media globale è risultata minore di un millesimo di grado. Ulteriori info sul baco del millennio"@it ;

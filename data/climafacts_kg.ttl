:claimreview_86a216d6f14c9428afa9c94d36532b08 a schema:ClaimReview ;
    owl:sameAs :claimreview_6e956e248fcb56fbf1f2b39f68847eb0 ;
    schema:author :person_46cf74d33e97a0cb9fb426d9c794cf38 ;
    schema:claimReviewed :claimreview_6e956e248fcb56fbf1f2b39f68847eb0 ;
    schema:headline "Sunce i klima su se mijenjali u suprotnim smjerovima u posljednjih 35 godina globalnog zagrijavanja."@hr ;
    schema:inLanguage "Croatian"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name """Krivo je Sunce\r
"""@hr ;
    schema:publisher :organization_sks ;
    schema:reviewBody """U posljednjih 35 godina Sunce pokazuje lagani trend smanjenja zagrijavanja. Ipak globalne temperature rastu. S obzirom da promjene sunčevog zračenja i klime idu u suprotnim smjerovima znanstvenici zaključuju kako Sunce ne može biti uzrok trenutnog globalnog zagrijavanja.
Jedini način za okriviti Sunce za trenutan porast temperature je kroz probiranje podataka. To je moguće učiniti na način da se prikazuju prošla razdoblja samo kada su se klima i Sunce mijenjali zajedno a istovremeno ignorirajući razdoblja kada su se mijenjali u suprotnim smjerovima."""@hr ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Sunce i klima su se mijenjali u suprotnim smjerovima u posljednjih 35 godina globalnog zagrijavanja."@hr ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text """U posljednjih 35 godina Sunce pokazuje lagani trend smanjenja zagrijavanja. Ipak globalne temperature rastu. S obzirom da promjene sunčevog zračenja i klime idu u suprotnim smjerovima znanstvenici zaključuju kako Sunce ne može biti uzrok trenutnog globalnog zagrijavanja.
Jedini način za okriviti Sunce za trenutan porast temperature je kroz probiranje podataka. To je moguće učiniti na način da se prikazuju prošla razdoblja samo kada su se klima i Sunce mijenjali zajedno a istovremeno ignorirajući razdoblja kada su se mijenjali u suprotnim smjerovima."""@hr ;
    schema:url "https://skepticalscience.com/translation.php?a=18&l=29"^^schema:URL .

:claimreview_86a2d14263b4edc3c09988349a2202ab a schema:ClaimReview ;
    owl:sameAs :claimreview_4ccb52548c45778d14f13827c2419e43 ;
    schema:author :person_83c1d66dd34d44075ce549c8a0c1bddb ;
    schema:claimReviewed :claimreview_4ccb52548c45778d14f13827c2419e43 ;
    schema:headline "Die unabhängige Revision der Klimawandel-Emails (Independent Climate Change Email Review) ging zurück bis zu den ursprünglichen Datenquellen und war in der Lage, die Ergebnisse der CRU zu reproduzieren. Dies bedeutet nicht nur, dass die CRU nichts verbarg sondern auch, dass sie nichts zu verbergen hatte. Auch wenn es die CRU versäumte, eine genaue Liste der Temperaturstationen zu liefern, hätte sie nichts verbergen oder Daten verfälschen können."@de ;
    schema:inLanguage "German"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Hat die CRU Temperaturdaten verfälscht? "@de ;
    schema:publisher :organization_sks ;
    schema:reviewBody ""@de ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Die unabhängige Revision der Klimawandel-Emails (Independent Climate Change Email Review) ging zurück bis zu den ursprünglichen Datenquellen und war in der Lage, die Ergebnisse der CRU zu reproduzieren. Dies bedeutet nicht nur, dass die CRU nichts verbarg sondern auch, dass sie nichts zu verbergen hatte. Auch wenn es die CRU versäumte, eine genaue Liste der Temperaturstationen zu liefern, hätte sie nichts verbergen oder Daten verfälschen können."@de ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text ""@de ;
    schema:url "https://skepticalscience.com/arg_CRU-verfaelschte-Temperaturdaten.htm"^^schema:URL .

:claimreview_86ec67b1a130e53464ef967616ebcb33 a schema:ClaimReview ;
    owl:sameAs :claimreview_9cfad585cc19b61fa7844fef39a2f537 ;

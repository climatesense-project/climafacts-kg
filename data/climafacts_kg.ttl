:claimreview_437f96dae5c6ba84b5e5f7d77917a789 a schema:ClaimReview ;
    owl:sameAs :claimreview_ef758a22e15b13bf380717400364645e ;
    schema:author :person_83c1d66dd34d44075ce549c8a0c1bddb ;
    schema:claimReviewed :claimreview_ef758a22e15b13bf380717400364645e ;
    schema:headline "Aktuell setzen wir Menschen ca. 29 Milliarden Tonnen Kohlendioxid pro Jahr in die Atmosphäre frei. Ungefähr 43% davon verbleiben in der Atmosphäre - was als der \"Anteil in der Luft\" bezeichnet wird. Der Rest wird von der Vegetation und den Ozeanen aufgenommen. Auch wenn es Fragen gibt, wie stark der \"Anteil in der Luft\" ansteigt, ist es doch klar, dass die Gesamtmenge von CO2 in der Atmosphäre dramatisch ansteigt. Der aktuelle CO2-Gehalt ist der höchste in 15 Millionen Jahren."@de ;
    schema:inLanguage "German"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Nimmt der CO2-Gehalt zu?"@de ;
    schema:publisher :organization_sks ;
    schema:reviewBody "[Weitere Informationen finden Sie bis zur vollständigen Übersetzung auf der englischsprachigen Originalseite]"@de ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Aktuell setzen wir Menschen ca. 29 Milliarden Tonnen Kohlendioxid pro Jahr in die Atmosphäre frei. Ungefähr 43% davon verbleiben in der Atmosphäre - was als der \"Anteil in der Luft\" bezeichnet wird. Der Rest wird von der Vegetation und den Ozeanen aufgenommen. Auch wenn es Fragen gibt, wie stark der \"Anteil in der Luft\" ansteigt, ist es doch klar, dass die Gesamtmenge von CO2 in der Atmosphäre dramatisch ansteigt. Der aktuelle CO2-Gehalt ist der höchste in 15 Millionen Jahren."@de ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text "[Weitere Informationen finden Sie bis zur vollständigen Übersetzung auf der englischsprachigen Originalseite]"@de ;
    schema:url "https://skepticalscience.com/arg_Zunahme-CO2-Gehalt-in-der-Luft.htm"^^schema:URL .

:claimreview_43938608b0413ae627de8e3a089f0290 a schema:ClaimReview ;
    owl:sameAs :claimreview_8f06068cad4e9a2b5fd4c95146c018a9 ;
    schema:author :person_b2a6c6df95c32fa2357c41df1b2e1920 ;
    schema:claimReviewed :claimreview_8f06068cad4e9a2b5fd4c95146c018a9 ;
    schema:headline "Diverse evidenze indicano che la riduzione dei ghiacci della Groenlandia è in crescendo e contribuirà all’aumento del livello del mare dell’ordine dei metri in qualche secolo."@it ;
    schema:inLanguage "Italian"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "La Groenlandia ha perso solo un piccola parte della sua massa totale di ghiaccio"@it ;
    schema:publisher :organization_sks ;
    schema:reviewBody "Sull’articolo On Being the Wrong Size, Willis Eschenbach arguisce che la perdita di ghiaccio annuale della Groenlandia è pari al 0.007% della sua massa totale. A questo ritmo occorreranno 15 mila anni per esaurirla. Qui sotto c’è una rappresentazione visiva della perdita del 2009 rispetto al totale della massa di ghiaccio."@it ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Diverse evidenze indicano che la riduzione dei ghiacci della Groenlandia è in crescendo e contribuirà all’aumento del livello del mare dell’ordine dei metri in qualche secolo."@it ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text "Sull’articolo On Being the Wrong Size, Willis Eschenbach arguisce che la perdita di ghiaccio annuale della Groenlandia è pari al 0.007% della sua massa totale. A questo ritmo occorreranno 15 mila anni per esaurirla. Qui sotto c’è una rappresentazione visiva della perdita del 2009 rispetto al totale della massa di ghiaccio."@it ;

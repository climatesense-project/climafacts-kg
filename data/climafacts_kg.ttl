:claimreview_d8bfd08925924e716ec6742592c082e2 a schema:ClaimReview ;
    owl:sameAs :claimreview_869d628ad73c9e74c99f0adf2f00f9d7 ;
    schema:author :person_bf0f5e428044546d1fbe59d08495fa0b ;
    schema:claimReviewed :claimreview_869d628ad73c9e74c99f0adf2f00f9d7 ;
    schema:headline "מצטברות עדויות לכך שסופות ההוריקן הולכות ומתחזקות בהשפעת ההתחממות הגלובלית."@he ;
    schema:inLanguage "Hebrew"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "מה הקשר בין סופות הוריקן להתחממות גלובלית?"@he ;
    schema:publisher :organization_sks ;
    schema:reviewBody """המחקר העדכני ביחס להשפעת שינויי האקלים על סופות טרופיות משקף את היושרה והשקיפות שבבסיס תהליך המחקר המדעי, ומהווה דוגמה נגדית לטענה הרווחת שבכל הנוגע להתחממות גלובלית, מדענים מתאימים את ממצאיהם לאג'נדה שהוגדרה מראש. ביחס לתדירות הסופות לא קיים קונצנזוס. קיימות שתי תאוריות מנוגדות, ומדענים בעלי שיעור קומה חלוקים ביניהם ביחס למנגנון המשפיע על תדירות הסופות.
בבסיס הקשר בין התחממות לסופות עומדת טענה פשוטה: תוספת חום באוויר או באוקיינוסים פירושה תוספת של אנרגיה, ואנרגיה כזו היא מקור כוחן של סופות ההוריקן. למרות זאת, לא ברור עדיין אם תדירות הסופות תעלה כתוצאה מתוספת האנרגיה, או שעוצמתן תגדל אך תדירותן תקטן.
מה מראים נתוני העבר? על פי הדו"ח של מרכז Pew לשינויי אקלים "בממוצע, מתרחשות 90 סופות טרופיות ברחבי העולם בכל שנה". על פי הדו"ח של IPCC AR4 מ-2007, "לא קיימת מגמה ברורה של שינוי במספר הסופות הטרופיות בשנה".
בניגוד לכתוב לעיל, בגרף המוצג כאן, גם הוא ממרכז Pew, רואים עליה של 40% בתדירות הסופות בצפון האוקיינוס האטלנטי ביחס למקסימום ההיסטורי משנות החמישים של המאה העשרים, שנחשב בזמנו לחריג.
בנוסף לכך, שני מחקרים מבוססים שפורסמו לאחרונה, הגיעו למסקנות סותרות לחלוטין. במאמר אחד מופיעה תחזית לעליה משמעותית בתדירות הסופות. במאמר האחר מופיעה תחזית הפוכה - מספר הסופות צפוי לרדת.
מה ניתן להסיק מכל המחקרים האלה? בנוגע לתדירות סופות ההוריקן - לא הרבה. מחלוקות כאלה הן לחם חוקו מחקר המדעי ראוי ומבוסס, ואין מנוס מלהמתין להמשך הדיון המדעי. ברור גם, שמסקנות מדעיות שאינן עולות בקנה אחד עם ההבנה הרווחת של תהליך ההתחממות אינן "מושתקות", ואין שום עדות לצנזורה או רדיפה של מדענים שמחקרם אינו תומך בממצאי ההתחממות ובסכנות הנובעות ממנה. המחקר המדעי מתקדם בשקיפות, והוא המקור האמין היחיד למידע על שינויי אקלים.
כל זה בנוגע לתדירות - מחקר מתמשך, אך אין תוצאות ודאיות.
ביחס לשינויים בעוצמתן של הסופות, לעומת זאת, קיימת הסכמה מדעית רחבה - עוצמתן של הסופות הטרופיות גדלה והן מחמירות. היחידה המתארת עוצמה (מהירות רוח) ומשך של סופה נקראת "אינדקס פיזור ההספק של הרוח" (DPI), ומחקרים מראים שמאז אמצע שנות השבעים קיימת התגברות בעוצמתן של הסופות.
על פי מחקרים עדכניים, מתרחשות יותר ויותר סופות עם מהירות רוח גבוהה, והסופות האלה הרסניות וממושכות יותר מבעבר. מאחר שעוצמת הסופות קשורה קשר הדוק לטמפרטורת פני הים, סביר להניח שיש קשר בין המגמה הזו לבין שינויי אקלים."""@he ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "מצטברות עדויות לכך שסופות ההוריקן הולכות ומתחזקות בהשפעת ההתחממות הגלובלית."@he ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

    schema:url "https://skepticalscience.com/translation.php?a=21&l=2"^^schema:URL .

:claimreview_4137998fb035645a7195c36d9160893e a schema:ClaimReview ;
    owl:sameAs :claimreview_ca7294ee1f13f82aa9a7736f67e6b9c1 ;

    schema:url "https://skepticalscience.com/translation.php?a=218&l=10"^^schema:URL .

:claimreview_f647814c9680e100706c18d6448ef876 a schema:ClaimReview ;
    owl:sameAs :claimreview_3283980a092ef53b3a34a8ce444dd4fc ;
    schema:author :person_bf0f5e428044546d1fbe59d08495fa0b ;
    schema:claimReviewed :claimreview_3283980a092ef53b3a34a8ce444dd4fc ;
    schema:headline "מחזורי האקלים ארוכי הטווח אינם יכולים להסביר את ההתחממות בעשורים האחרונים, ואינם קשורים אליה."@he ;
    schema:inLanguage "Hebrew"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "מה הקשר בין מחזורי האקלים הטבעיים לבין ההתחממות הגלובלית?"@he ;
    schema:publisher :organization_sks ;
    schema:reviewBody """הטענה שההתחממות בעשורים האחרונים קשורה למחזור 1500 השנה היא טענה מעניינת, משתי סיבות. קודם כל, הטענה הזו מעידה על הכרה בכך שקיימת מגמת התחממות, בניגוד לרוב הטענות של מכחישי שינוי האקלים, שאינם מכירים כלל בקיומה של מגמה כזו.
בנוסף, הטענה הזו אינה עולה בקנה אחד עם קיומו של "אפקט החממה". רעיון שעלה לראשונה לפני יותר מ-100 שנה, ושרבים מהמכחישים את תרומת האדם להתחממות הגלובלית מכירים בנכונותו.
מחזור 1500 השנה נצפה בעיקר בנתונים מליבות קרח, מהם ניתן ללמוד שתקופות של התחממות בחצי הכדור הצפוני תואמות להתקררות בחצי הכדור הדרומי. מדובר, אם כך, בשינויים בהתפלגות הטמפרטורה על פני כדור הארץ - מעיין "זיגזוג" של הטמפרטורה בין שני חצאי הכדור (תופעה המכונה "Polar see-saw"), שאינו משפיע על על סך החום במערכת כולה.
בניגוד לתופעה הזו, ההתחממות בהשפעת האנושות נגרמת עקב עליה חדה בריכוז הפחמן הדו חמצני באטמוספירה ב-200 השנים האחרונות - לרמה של מעל 400 חלקיקים למיליון, אחרי 800,000 שנים שבהם הריכוז היה מתחת 300 חלקיקים למיליון. בשונה מהמחזור הטבעי שתואר לעיל, השינוי הנוכחי מופיע בכל רחבי כדור הארץ, ביבשות ובאוקיינוסים."""@he ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "מחזורי האקלים ארוכי הטווח אינם יכולים להסביר את ההתחממות בעשורים האחרונים, ואינם קשורים אליה."@he ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text """הטענה שההתחממות בעשורים האחרונים קשורה למחזור 1500 השנה היא טענה מעניינת, משתי סיבות. קודם כל, הטענה הזו מעידה על הכרה בכך שקיימת מגמת התחממות, בניגוד לרוב הטענות של מכחישי שינוי האקלים, שאינם מכירים כלל בקיומה של מגמה כזו.
בנוסף, הטענה הזו אינה עולה בקנה אחד עם קיומו של "אפקט החממה". רעיון שעלה לראשונה לפני יותר מ-100 שנה, ושרבים מהמכחישים את תרומת האדם להתחממות הגלובלית מכירים בנכונותו.
מחזור 1500 השנה נצפה בעיקר בנתונים מליבות קרח, מהם ניתן ללמוד שתקופות של התחממות בחצי הכדור הצפוני תואמות להתקררות בחצי הכדור הדרומי. מדובר, אם כך, בשינויים בהתפלגות הטמפרטורה על פני כדור הארץ - מעיין "זיגזוג" של הטמפרטורה בין שני חצאי הכדור (תופעה המכונה "Polar see-saw"), שאינו משפיע על על סך החום במערכת כולה.
בניגוד לתופעה הזו, ההתחממות בהשפעת האנושות נגרמת עקב עליה חדה בריכוז הפחמן הדו חמצני באטמוספירה ב-200 השנים האחרונות - לרמה של מעל 400 חלקיקים למיליון, אחרי 800,000 שנים שבהם הריכוז היה מתחת 300 חלקיקים למיליון. בשונה מהמחזור הטבעי שתואר לעיל, השינוי הנוכחי מופיע בכל רחבי כדור הארץ, ביבשות ובאוקיינוסים."""@he ;

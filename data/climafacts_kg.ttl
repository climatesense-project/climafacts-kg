Дальнейшее чтение: Спенсер Уирт «Открытие глобального потепления» более подробно описывает исследовательскую деятельность Чарльза Килинга. У Уарт также есть отдельная статья о борьбе Килинга за финансирование его исследований."""@ru ;
    schema:url "https://skepticalscience.com/translation.php?a=266&l=16"^^schema:URL .

:claimreview_c27f8e84bebdac0d618f3bb46a2cbbfe a schema:ClaimReview ;
    owl:sameAs :claimreview_33a34d26946da0389843775c3dc60f83 ;
    schema:author :person_cdbcfb10919e9e8b99a1c9b8b21c84bb ;
    schema:claimReviewed :claimreview_33a34d26946da0389843775c3dc60f83 ;
    schema:headline """Базовый уровень

    schema:headline "On lisääntyvä määrä empiirisiä todisteita siitä, että lämpeneminen aiheuttaa voimakkaampia hurrikaaneja, rankempia sateita ja tulvia, lisääntynyttä metsäpaloalttiutta ja vaarallisia helleaaltoja."@fi ;
    schema:inLanguage "Finnish"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Ilmaston lämpeneminen ei aiheuta äärimmäisiä sääilmiöitä"@fi ;
    schema:publisher :organization_sks ;
    schema:reviewBody "."@fi ;

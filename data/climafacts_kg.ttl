            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "A redução do gelo marinho do Ártico, durante o verão do hemisfério norte, foi do tamanho da Austrália Ocidental, podendo desaparecer completamente em uma década."@pt ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

    schema:claimReviewed :claimreview_9cfad585cc19b61fa7844fef39a2f537 ;
    schema:headline "ישנם קווי ראיות רבים המצביעים על התחממות גלובלית באופן חד-משמעי."@he ;
    schema:inLanguage "Hebrew"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "מהן בכלל הראיות להתחממות הגלובלית?"@he ;
    schema:publisher :organization_sks ;
    schema:reviewBody """דו"ח מצב האקלים לשנת 2009 של המנהל האוקיאני והאטמוספרי הלאומי האמריקאי (NOAA), שפורסם באמצע 2010, מביא סדרות נתונים שונות "מפסגת האטמוספירה עד לעומקי האוקיינוס". המסקנה? כל קווי הראיות הבלתי-תלויים האלה אומרים לנו באופן חד משמעי שכדור-הארץ מתחמם.
הסיכום המאוד נגיש בן ה-10 עמודים בוחן את המגמות של 10 מדדי מפתח אקלימיים באמצעות 47 סטים שונים של נתונים. כל המדדים שצפויים לעלות בעולם מתחמם, אכן עולים, וכל אלו שצפויים לרדת, אכן יורדים:
מדדים להתחממות -
10 המדדים הם:
טמפ' האוויר סמוך לקרקע כפי שנמדדה בתחנות מזג-אוויר. אתם מכירים את כל הטיעונים הסקפטיים בקשר לדרך שבה תיעודי הטמפרטורה מוטים ע"י אפקט אי החום העירוני, תחנות מזג-אויר במצב ירוד, תחנות שנפלו וכו'? זהו המדד היחיד שסובל מכל הבעיות הללו. אז אם אתם מתווכחים עם מישהו שמנסה למסגר את הדיון כדיון על טמפ' האוויר סמוך לקרקע, פשוט תזכירו לו את תשעת המדדים האחרים.
טמפרטורת פני הים. כמו עם טמפ' הקרקע, התיעוד הרחוק ביותר הולך אחורה עד 1850 והעשור האחרון הוא החם ביותר.
טמפ' האוויר מעל האוקיינוסים.
טמפ' הטרופוספירה הנמוכה כפי שנמדדה ע"י לוויינים במשך כ-50 שנה. ע"י כל אחת מהמדידות, העשור של שנות ה-2000 היה העשור החם ביותר וכל אחד משלושת העשורים האחרונים היה חם בהרבה מקודמו.
תכולת החום של האוקיינוס, אשר עבורה התיעודים הולכים אחורה מעל חצי-מאה. יותר מ-90% מהחום העודף מההתחממות הגלובלית הולך לאוקיינוסים, תורם לעלייה של...
מפלס הים. תיעודי מדדי הגאות הולכים אחורה עד 1870, ומפלס הים עולה בצורה מואצת.
לחות סגולית, עלתה בהתאמה לעליית הטמפרטורה.
קרחונים. 2009 הייתה השנה ה-19 ברציפות שבה הייתה ירידה משמעותית בכמות הקרח קרחונים ברחבי העולם.
שכבת השלג בהמיספרה הצפונית, שגם כן דעכה בעשורים האחרונים.
אולי השינוי הדרמטי מכולם היה בקרח הים הארקטי. מדידות לוויינים זמינות מ-1979 ותיעודי משלוחים אמינים מ-1953. השתרעות הקרח הימי בחודש ספטמבר הצטמצמה ב-35% מאז 1979.
מדע הוא לא כמו בניין קלפים, כך שהפלת שורת ראיות אחת (לדוגמא טמפ' האוויר הסמוך לקרקע) לא תגרום להתמוטטות כל המבנה של ההתחממות הגלובלית כתוצאה מפעילות אנושית.
במקום זה, "התחממות פני הקרקע" היא אחת מתוך יותר מ-10 אבני הבניין שתומכות ב"התחממות הגלובלית". עכשיו, כשהתיאוריה המסבירה את ההתחממות הגלובלית כבר מבוססת, יש סט שלם נוסף של אבני בניין שתומכות ב"התחממות גלובלית כתוצאה מפעילות אנושית". על מנת לערער על מסקנות אלו, תצטרכו להתעלם מרוב או מכל אבני הבניין שתומכות בהן- אך ככל שהראיות התומכות בתיאוריה ממשיכות להיערם, התעלמות מהן הולכת ונעשית פחות ופחות סבירה.
תורגם לעברית ע"י סטודנטים בקורס "מבוא לאקלים" באוניברסיטה העברית בירושלים.
תרגום: עידו בורוכובסקי
הגהה :מיה שורקי"""@he ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "ישנם קווי ראיות רבים המצביעים על התחממות גלובלית באופן חד-משמעי."@he ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

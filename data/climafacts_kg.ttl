            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Le conseguenze negative del riscaldamento globale sull’agricoltura, sulla salute , l’economia e l’ambiente superano di gran lunga quelle positive."@it ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

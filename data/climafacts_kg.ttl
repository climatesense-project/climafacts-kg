:claimreview_6ab6d0f21bae0d9a6bd61ca746136851 a schema:ClaimReview ;
    owl:sameAs :claimreview_60b4adf6ed7e39f7bf8bcdfce035adcf ;
    schema:author :person_83c1d66dd34d44075ce549c8a0c1bddb ;
    schema:claimReviewed :claimreview_60b4adf6ed7e39f7bf8bcdfce035adcf ;
    schema:headline "Werden die CO2-Emissionen direkt mit der CO2-Konzentration verglichen, zeigt sich eine deutliche Übereinstimmung in den langfristigen Trends. Eine unabhängige Bestätigung hierfür sind die Kohlenstoff-Isotope: Das Verhältnis von C13 zu C12 nimmt ab und dies korreliert mit den Emissionen fossiler Brennstoffe."@de ;
    schema:inLanguage "German"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Vergleich zwischen CO2-Emissionen und CO2-Konzentration "@de ;
    schema:publisher :organization_sks ;
    schema:reviewBody ""@de ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Werden die CO2-Emissionen direkt mit der CO2-Konzentration verglichen, zeigt sich eine deutliche Übereinstimmung in den langfristigen Trends. Eine unabhängige Bestätigung hierfür sind die Kohlenstoff-Isotope: Das Verhältnis von C13 zu C12 nimmt ab und dies korreliert mit den Emissionen fossiler Brennstoffe."@de ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text ""@de ;
    schema:url "https://skepticalscience.com/arg_CO2-Emissionen-Korrelation-mit-CO2-Konzentration.htm"^^schema:URL .

:claimreview_6ac2bbc66b1c12ebeb9ccda775ed0532 a schema:ClaimReview ;
    owl:sameAs :claimreview_8ccbafd5e2321dff00b28c2b9b16e9cf ;
    schema:author :person_bf0f5e428044546d1fbe59d08495fa0b ;
    schema:claimReviewed :claimreview_8ccbafd5e2321dff00b28c2b9b16e9cf ;
    schema:headline "מגמת התחממות דומה נצפית באזורים עירוניים ובאזורים כפריים."@he ;
    schema:inLanguage "Hebrew"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "האם איי חום עירוניים משפיעים על מדידות הטמפרטורה וגורמים להערכת יתר של ההתחממות?"@he ;
    schema:publisher :organization_sks ;
    schema:reviewBody """התופעה המכונה "אי חום עירוני" מתרחשת כאשר ריכוז של מבנים ושל פליטת חום ממקור אנושי (בעיקר מערכות מיזוג אוויר ומנועי בעירה פנימית) יוצרים מעל אזורים עירוניים מעטפת אוויר חמה ביחס לאזורים הסמוכים שאינן עירוניים. עלתה הטענה שהתופעה הזו משפיעה באופן משמעותי על מדידות הטמפרטורה שנעשו במאה ה-20, בעקבות ההתרחבות המהירה של אזורים עירוניים.בדיקות מדעיות מדוקדקות נעשו כדי לבחון את השפעת החום העירוני של מגמות הטמפרטורה. על מנת לבחון את הסברה שלעיל, הושוו נתונים מתחנות מדידה מרוחקות (שאינן מושפעות משום אזור עירוני) לנתונים מאזורים עירוניים. כמו כן, נבחנו אזורים כפריים ועירוניים ברחבי סין, שבה התרחבות האזורים העירוניים ב-30 השנים האחרונות היתה מהירה ביותר, ולכן צפויה להתגלות שם השפעתם של "איי חום עירוניים". ההבדלים שנמצאו במגמת ההתחממות באזורים נידחים ובאזורים עירוניים הם קטנים מאוד:
תופעת איי החום העירוניים אינה משפיעה משמעותית על מדידות הטמפרטורה ועל המסקנות ביחס לשינויי הטמפרטורה הגלובלית."""@he ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "מגמת התחממות דומה נצפית באזורים עירוניים ובאזורים כפריים."@he ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

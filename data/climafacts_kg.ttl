            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Auch wenn die sommerlichen Höchsttemperaturen so gut wie gar keinen Trend erkennen ließen, sind die Jahresdurchschnittswerte der arktischen Temperaturen in den letzten Jahrzehnten sehr stark angestiegen. Dies wird sowohl von den GISS- als auch den DMI-Daten gezeigt."@de ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text ""@de ;

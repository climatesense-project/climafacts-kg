:claimreview_344ec7f37602e0ccebf5a9a5ab617fad a schema:ClaimReview ;
    owl:sameAs :claimreview_5fb76a0716641e8376cf0b343f4694f2 ;
    schema:author :person_83c1d66dd34d44075ce549c8a0c1bddb ;

    schema:author :person_4171b9f993a6f0080a00aca6b0bcc804 ;
    schema:citation "http://news.bbc.co.uk/1/hi/sci/tech/3869753.stm"^^schema:URL ;
    schema:claimReviewed :claimreview_b11cdb34eb58b08cd3903746ab9760eb ;
    schema:dateCreated "2023-05-27T00:00:00"^^schema:Date ;
    schema:description "In the last 35 years of global warming, the sun has shown a slight cooling trend. Sun and climate have been going in opposite directions."@en ;
    schema:headline "Climate Myth..."@en ;
    schema:inLanguage "English"^^schema:Text ;
    schema:keywords "CO2 emissions"@en,
        "climate change"@en,
        "global warming"@en,
        "skepticism"@en,
        "skeptics"@en ;

:claimreview_47b142a9575f099c249856da23d4656b a schema:ClaimReview ;
    owl:sameAs :claimreview_dea9ad4c58ea6527ce63cee44d1effc1 ;
    schema:author :person_bf0f5e428044546d1fbe59d08495fa0b ;
    schema:claimReviewed :claimreview_dea9ad4c58ea6527ce63cee44d1effc1 ;
    schema:headline "התהליך הטבעי מוסיף ומסלק פחמן דו חמצני וכך נשמר האיזון; בני האדם מוסיפים עוד פחמן דו חמצני ואינם תורמים לסילוקו, ובכך מפרים את האיזון."@he ;
    schema:inLanguage "Hebrew"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "מה היחס בין כמות הפחמן הדו חמצני שנפלט כתוצאה מפעולות אנוש, לכמות שנפלטת באופן טבעי?"@he ;
    schema:publisher :organization_sks ;
    schema:reviewBody """לפני המהפכה התעשייתית, כמות הפחמן הדו חמצני באטמוספירה היתה יציבה במשך אלפי שנים. עם זאת, רמת הפחמן הדו חמצני הטבעי אינה קבועה. הפחמן הדו חמצני נפלט כתוצאה מתהליכים טבעיים מסוימים, ונקלט כתוצאה מתהליכים אחרים.
כפי שניתן לראות בתמונה 1, הפחמן שמקורו בקרקע ובאוקיינוסים נמצא, פחות או יותר, באיזון מזה זמן רב - ניתן לקבוע זאת על סמך מדידות של ריכוזי הפחמן הדו חמצני באטמוספירה בתקופות שונות בהיסטוריה גם באופן ישיר (בקידוחי קרח) וגם באופן עקיף (באמצעות הערכות).
נבחן מה קורה בעקבות התווספות של פחמן דו חמצני ממקור שאינו חלק ממחזור הפחמן הטבעי - כתוצאה משריפת דלקים מאובנים. הכמות הנפלטת כתוצאה מפעילות אנוש, 29 מיליארד טונות, היא אכן קטנה ביחס ל-750 מיליארדי הטונות העוברים במחזור הפחמן בכל שנה. מאידך, התוספת הזו מצטברת באטמוספירה, מכיוון שהקרקע והאוקיינוסים אינם יכולים לספוג את כל הפחמן הדו חמצני העודף. בערך 40% ממנו נספג, והשאר נותר באטמוספירה. כתוצאה מכך, כמות הפחמן הדו חמצני באטמוספירה היא הגבוהה ביותר ב-15-20 מיליון שנים האחרונות (Tripati 2009). ריכוז חלקיקי הפחמן באטמוספירה עלה ב-120 השנים האחרונות ב-100 ppm (חלקיקים למיליון), שינוי שבאופן טבעי אורך כ-5,000 עד 20,000 שנים.
הפחמן הדו חמצני שפולטים בני האדם פוגע באיזון הטבעי של מחזור הפחמן. ריכוז הפחמן הדו חמצני ממקור אנושי באטמוספירה גדל פי שלוש מאז התקופה הקדם תעשייתית. עליית הריכוז הפרה את האיזון הטבעי וגרמה להתחממותו של כדור הארץ. גם אם הפחמן הדו חמצני הנפלט כתוצאה משריפת דלקים מאובנים מהווה אחוז קטן קטן במחזור הפחמן הגלובלי, הכמות הנוספת הזו מצטברת, מכיוון שהטבע לא מסוגל לספוג אותה.
כמות הפחמן הדו חמצני באטמוספירה הולכת ועולה כתוצאה משריפת דלקים מאובנים, והעלייה הזו מאיצה עם הזמן."""@he ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "התהליך הטבעי מוסיף ומסלק פחמן דו חמצני וכך נשמר האיזון; בני האדם מוסיפים עוד פחמן דו חמצני ואינם תורמים לסילוקו, ובכך מפרים את האיזון."@he ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text """לפני המהפכה התעשייתית, כמות הפחמן הדו חמצני באטמוספירה היתה יציבה במשך אלפי שנים. עם זאת, רמת הפחמן הדו חמצני הטבעי אינה קבועה. הפחמן הדו חמצני נפלט כתוצאה מתהליכים טבעיים מסוימים, ונקלט כתוצאה מתהליכים אחרים.
כפי שניתן לראות בתמונה 1, הפחמן שמקורו בקרקע ובאוקיינוסים נמצא, פחות או יותר, באיזון מזה זמן רב - ניתן לקבוע זאת על סמך מדידות של ריכוזי הפחמן הדו חמצני באטמוספירה בתקופות שונות בהיסטוריה גם באופן ישיר (בקידוחי קרח) וגם באופן עקיף (באמצעות הערכות).

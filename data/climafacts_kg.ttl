:claimreview_ef2613c24da4e26d5abb2ba77797ba69 a schema:ClaimReview ;
    owl:sameAs :claimreview_96ae1f944a3a6bf0f942b95cde170d14 ;
    schema:author :person_29275b167b2e92810d2e7203da53de01 ;
    schema:claimReviewed :claimreview_96ae1f944a3a6bf0f942b95cde170d14 ;
    schema:headline "Les mesures empiriques de la chaleur globale de la Terre montrent que la planète est toujours en train d’accumuler de la chaleur et que le réchauffement climatique est toujours d’actualité. Il est possible d’observer un refroidissement temporaire lorsqu’il y a un échange de chaleur entre l’atmosphère et l’océan, qui a une plus grande capacité de réchauffement que l’air."@fr ;
    schema:inLanguage "French"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Le réchauffement climatique est-il toujours d’actualité ?"@fr ;
    schema:publisher :organization_sks ;
    schema:reviewBody ""@fr ;

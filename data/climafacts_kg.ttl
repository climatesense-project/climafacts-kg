    schema:author :person_4171b9f993a6f0080a00aca6b0bcc804 ;
    schema:citation "http://news.bbc.co.uk/1/hi/sci/tech/3869753.stm"^^schema:URL,
        "http://news.bbc.co.uk/2/hi/science/nature/3869753.stm"^^schema:URL,
        "http://translate.googleusercontent.com/translate_c?depth=1&hl=id&prev=search&rurl=translate.google.com&sl=en&u=http://news.bbc.co.uk/1/hi/sci/tech/3869753.stm&usg=ALkJrhgMKiJ67vW0cXdR4wxseZlrNAp-zA"^^schema:URL,
        "http://translate.googleusercontent.com/translate_c?hl=da&sl=en&u=http://news.bbc.co.uk/1/hi/sci/tech/3869753.stm&prev=/search%3Fq%3Dit%2Bis%2Bthe%2Bsun%2Bskeptical%26hl%3Dda%26sa%3DG&rurl=translate.google.dk&usg=ALkJrhjIvitfrdAP2u_2bsfMmtHm2DXwMg"^^schema:URL,

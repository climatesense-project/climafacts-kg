:claimreview_d81a711d8fdb1a811335d1406808bb7b a schema:ClaimReview ;
    owl:sameAs :claimreview_367af13158dfbb9fa7ecf5856c1ea544 ;
    schema:author :person_83c1d66dd34d44075ce549c8a0c1bddb ;
    schema:claimReviewed :claimreview_367af13158dfbb9fa7ecf5856c1ea544 ;
    schema:headline "Lindzens Analyse hat mehrere Schwächen wie z. B. die Tatsache, dass sie nur die Daten der Tropen berücksichtigt. Mehrere unabhängige Studien, die Satellitendaten von so gut wie dem ganzen Globus verwenden, stellen positive Rückkopplungen und eine hohe Klimasensitivität fest."@de ;
    schema:inLanguage "German"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Die Klimasensitivität aus Satellitenmessungen ermitteln"@de ;
    schema:publisher :organization_sks ;
    schema:reviewBody ""@de ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Lindzens Analyse hat mehrere Schwächen wie z. B. die Tatsache, dass sie nur die Daten der Tropen berücksichtigt. Mehrere unabhängige Studien, die Satellitendaten von so gut wie dem ganzen Globus verwenden, stellen positive Rückkopplungen und eine hohe Klimasensitivität fest."@de ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text ""@de ;

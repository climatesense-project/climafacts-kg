    schema:headline "Ruß verbleibt nur Tage oder Wochen in der Atmosphäre; Kohlendioxid verursacht über Jahrhunderte hinweg eine Erwärmung."@de ;
    schema:inLanguage "German"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Russ und die globale Erwärmung"@de ;

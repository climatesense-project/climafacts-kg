            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Aggódjunk a globális felmelegedés hatásai miatt a következő 100 évben – ne egy jégkorszak miatt, ami több mint 10 000 év múlva jöhet."@hu ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

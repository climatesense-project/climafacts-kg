:claimreview_6fc3acf4c163be9211bb56000bef8fa5 a schema:ClaimReview ;
    owl:sameAs :claimreview_6e956e248fcb56fbf1f2b39f68847eb0 ;
    schema:author :person_bf0f5e428044546d1fbe59d08495fa0b ;
    schema:claimReviewed :claimreview_6e956e248fcb56fbf1f2b39f68847eb0 ;
    schema:headline "סך האנרגיה הנפלטת מהשמש פחת מאז 1980, אך כדור הארץ ממשיך להתחמם בקצב גובר והולך."@he ;
    schema:inLanguage "Hebrew"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "זו השמש"@he ;
    schema:publisher :organization_sks ;
    schema:reviewBody """ב-35 השנים האחרונות הטמפרטורה שהשמש "מכתיבה" לכדור הארץ נמצאת במגמת ירידה, במקביל לעליה בטמפרטורה הגלובלית. הירידה באנרגיה הנפלטת מהשמש במקביל להתחממות הגלובלית מעידה על כך שהשמש אינה הגורם המרכזי המשפיע על הטמפרטורה בכדור הארץ.
גרף 1 מראה את הטמפרטורה העולמית ואת כמות הקרינה הסולארית המגיעה לכדור הארץ לאורך השנים. התנודות באנרגיה השמש הן בעלות מחזור אופייני של 11 שנים. במהלך כל מחזור, האנרגיה משתנה ב-0.1%. אם קרינת השמש היתה הגורם הדומיננטי, הטמפרטורה היתה יורדת בין השנים 2000 ו-2008.
גרף 1: טמפרטורה שנתית (אדום בהיר) וממוצע 11 שנתי (אדום כהה), על פי שנה. הטמפרטורה מתוך מדידות GISS של נאס"א.
עוצמת קרינה סולארית שנתית (כחול בהיר) וממוצע 11 שנתי (כחול כהה). ערכים עבור 1880 עד 1978 מ- Krivova et al 2007. עבור 1979 עד 2015 מ-World Radiation Center (ראו שם למידע מעודכן).
גרף מעודכן של עוצמות הקרינה הסולרית אפשר למצוא באתר של Laboratory for Atmospheric and Space Physics LISIRD
התנודות בקרינה הסולארית מאז 1870 תרמו לכל היותר 0.1 מעלה צלזיוס לשינוי הטמפרטורה בכדור הארץ. התנודה המשמעותית ביותר בשנים האחרונות ארעה ב-1960, אך ההתחממות הגלובלית המשמעותית החלה ב-1980.
גרף 2 מציג תרומה של גורמים שונים להתחממות בשנים האחרונות. מוצגת השוואה של השפעת השמש, הרי געש, אל ניניו ואפקט החממה. קרינת השמש תרמה 0.02 עד 0.1 מעלה. הרי געש גרמו להתקררות של כדור הארץ ב-0.1 עד 0.2 מעלה. תופעות טבע (כמו אל ניניו) גרמו לתנודות, חימום או קירור, של 0.1 עד 0.2 מעלה. אפקט החממה גרם להתחממות של מעל 0.8 מעלה.
גרף 2: טמפרטורת פני השטח בין השנים 1870 ל-2010, והגורמים הטבעיים (קרינה השמש, הרי געש, תופעות טבע) והאנושיים שהשפיעו עליהן.
a. השוואה בין טמפרטורת פני השטח שנמדדה (קו שחור), לזו הצפויה על פי סכום המודלים המפורטים בגרפים הבאים (קו אדום). בשני המקרים מוצג הפרש מהטמפרטורה הממוצעת בשנים 1961-1990.
b. תנודות הטמפרטורה הצפויות בהשפעת הקרינה הסולארית.
c. תנודות הטמפרטורה הצפויות בהשפעת התפרצויות וולקאניות.
d. תנודות הטמפרטורה הצפויות בהשפעת מערכת האקלים ותופעות טבע (כמו אל ניניו).
e. תנודות הטמפרטורה הצפויות בהשפעת גורמים מעשה ידי אדם - חמום בהשפעת אפקט החממה, וקירור עקב הצטברות אירוסולים.
מקור - IPCC AR5, פרק 5
קיימת טענה, לפיה קרינת השמש היא הגורם המשפיע על עליית הטמפרטורה בכדור הארץ. הטענה הזו מבוססת על בחירת נתונים סלקטיבית, התעלמות מהמכלול, והתמקדות בפרקי זמן בהם קיימת התאמה בין עוצמת הקרינה לשינויי האקלים. המסקנה השגויה מבוססת על התעלמות מהעשורים האחרונים, בהם לא מתקיימת התאמה כזו."""@he ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "סך האנרגיה הנפלטת מהשמש פחת מאז 1980, אך כדור הארץ ממשיך להתחמם בקצב גובר והולך."@he ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

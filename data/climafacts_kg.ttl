:claimreview_382eede393cf2fcfae81f73449db7096 a schema:ClaimReview ;
    owl:sameAs :claimreview_0b560e60e3e6c7d4b9a61bbf68d5c96c ;
    schema:author :person_bf0f5e428044546d1fbe59d08495fa0b ;
    schema:claimReviewed :claimreview_0b560e60e3e6c7d4b9a61bbf68d5c96c ;
    schema:headline "עלייה בריכוז הפחמן הדו חמצני גוררת עלייה בריכוז אדי המים, שגם הם מהווים גז חממה המוסיף לתהליך ההתחממות."@he ;
    schema:inLanguage "Hebrew"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "כיצד משפיעים אדי מים באטמוספירה על אפקט החממה?"@he ;
    schema:publisher :organization_sks ;
    schema:reviewBody "מכחישי ההתחממות משתמשים בטיעון הזה כדי להגיע למסקנה שהעליה בריכוז הפחמן הדו חמצני אינה הגורם העיקרי להתחממות. אם הפחמן הדו חמצני מתון בהשפעתו כגז חממה ביחס לאדי מים, לא יתכן שעלייה בריכוז שלו תהיה בעלת השפעה גדולה, האין זאת? הכשל בטיעון הזה טמון בהתעלמות ממנגנון המשוב החיובי שנוצר באטמוספירה ומגביר את השפעתו של הפחמן הדו חמצני.ריכוז אדי המים באטמוספירה תלוי בטמפרטורה. ככל שהטמפרטורה עולה, יותר מים מתאדים והריכוז עולה, ולהפך. כאשר גורם כלשהו (למשל פחמן דו חמצני שמקורו בדלקי מאובנים) גורם להתחממות, ההתחממות גורמת לעליה בריכוז אדי המים ולאפקט חממה שמחזק את ההתחממות, וכך נוצר מנגנון של משוב חיובי.מה תרומתו של מנגנון המשוב הזה לשינוי הטמפרטורה, או - עד כמה העלייה בריכוז האדים מגבירה את ההתחממות בהשפעת הפחמן הדו חמצני? מחקרים מראים, שמנגנון המשוב החיובי מכפיל בקירוב את ההתחממות שהיתה נוצרת בלעדיו. לכן, אם השינוי בריכוז הפחמן הדו חמצני הוא כזה שגורם לשינוי של מעלה אחת צלסיוס, אדי המים הנוצרים בגללו יוסיפו מעלת חום נוספת. בפועל קיימים עוד מנגנונים של משוב חיובי, ועליית הטמפרטורה במצב כזה תגיע כמעט לשלוש מעלות צלזיוס.צריך לזכור גם שמים מתאדים מהים ונופלים כמשקעים כל הזמן. ריכוז האדים באטמוספירה משתנה ממקום למקום ומשעה לשעה בהתאם לתנאי מזג האוויר. לכן, גם אם אדים הם גז חממה דומיננטי, זמן החיים שלו באטמוספירה קצר וריכוזו משתנה בסקלת זמן קצרה. פחמן דו חמצני, לעומת זאת, מסולק מהאטמוספירה באמצעות תהליכים גיאולוגיים בעלי סקלת זמן ארוכה הרבה יותר. כתוצאה מכך, פחמן דו חמצני שמגיע לאטמוספירה נשאר בה עשרות ואפילו מאות שנים. לעלייה קטנה בריכוז הפחמן הדו חמצני יכולה להיות השפעה ארוכת טווח.אדי מים הם אכן גז חממה דומיננטי. תהליך המשוב החיובי שתחילתו בעלייה בריכוז הפחמן הדו חמצני דומיננטי עוד יותר."@he ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "עלייה בריכוז הפחמן הדו חמצני גוררת עלייה בריכוז אדי המים, שגם הם מהווים גז חממה המוסיף לתהליך ההתחממות."@he ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text "מכחישי ההתחממות משתמשים בטיעון הזה כדי להגיע למסקנה שהעליה בריכוז הפחמן הדו חמצני אינה הגורם העיקרי להתחממות. אם הפחמן הדו חמצני מתון בהשפעתו כגז חממה ביחס לאדי מים, לא יתכן שעלייה בריכוז שלו תהיה בעלת השפעה גדולה, האין זאת? הכשל בטיעון הזה טמון בהתעלמות ממנגנון המשוב החיובי שנוצר באטמוספירה ומגביר את השפעתו של הפחמן הדו חמצני.ריכוז אדי המים באטמוספירה תלוי בטמפרטורה. ככל שהטמפרטורה עולה, יותר מים מתאדים והריכוז עולה, ולהפך. כאשר גורם כלשהו (למשל פחמן דו חמצני שמקורו בדלקי מאובנים) גורם להתחממות, ההתחממות גורמת לעליה בריכוז אדי המים ולאפקט חממה שמחזק את ההתחממות, וכך נוצר מנגנון של משוב חיובי.מה תרומתו של מנגנון המשוב הזה לשינוי הטמפרטורה, או - עד כמה העלייה בריכוז האדים מגבירה את ההתחממות בהשפעת הפחמן הדו חמצני? מחקרים מראים, שמנגנון המשוב החיובי מכפיל בקירוב את ההתחממות שהיתה נוצרת בלעדיו. לכן, אם השינוי בריכוז הפחמן הדו חמצני הוא כזה שגורם לשינוי של מעלה אחת צלסיוס, אדי המים הנוצרים בגללו יוסיפו מעלת חום נוספת. בפועל קיימים עוד מנגנונים של משוב חיובי, ועליית הטמפרטורה במצב כזה תגיע כמעט לשלוש מעלות צלזיוס.צריך לזכור גם שמים מתאדים מהים ונופלים כמשקעים כל הזמן. ריכוז האדים באטמוספירה משתנה ממקום למקום ומשעה לשעה בהתאם לתנאי מזג האוויר. לכן, גם אם אדים הם גז חממה דומיננטי, זמן החיים שלו באטמוספירה קצר וריכוזו משתנה בסקלת זמן קצרה. פחמן דו חמצני, לעומת זאת, מסולק מהאטמוספירה באמצעות תהליכים גיאולוגיים בעלי סקלת זמן ארוכה הרבה יותר. כתוצאה מכך, פחמן דו חמצני שמגיע לאטמוספירה נשאר בה עשרות ואפילו מאות שנים. לעלייה קטנה בריכוז הפחמן הדו חמצני יכולה להיות השפעה ארוכת טווח.אדי מים הם אכן גז חממה דומיננטי. תהליך המשוב החיובי שתחילתו בעלייה בריכוז הפחמן הדו חמצני דומיננטי עוד יותר."@he ;

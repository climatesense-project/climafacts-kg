:claimreview_10becbf2cc2f9007fdc1bf11bca67b1f a schema:ClaimReview ;
    owl:sameAs :claimreview_185290c06f995251914ee55fa4f7837a ;
    schema:author :person_90a47cfbdd2b392cf06037b43e06f2ed ;
    schema:claimReviewed :claimreview_185290c06f995251914ee55fa4f7837a ;
    schema:headline "1934 on tilastojen mukaan lämpimin vuosi USA:ssa, joka kattaa ainoastaan 2 % maapallon pinta-alasta. NASA:n tilastoissa lämpimin vuosi maailmanlaajuisesti on 2005."@fi ;
    schema:inLanguage "Finnish"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "1934 on mittaushistorian lämpimin vuosi"@fi ;
    schema:publisher :organization_sks ;
    schema:reviewBody """Steve McIntyren havainto GISS-lämpötiladatan virheestä on vaikuttava saavutus. Kyseessä oli nolo erehdys NASA:lta. Mutta mikä sen merkitys on?
Toisin kuin monet raportit kertovat, kyseessä ei ollut Y2K-bugi, vaan sekaannus NOAA:n korjauksissa. NASA:n GISS saa suuren osan tiedoistaan NOAA:lta, joka tekee tietoihin korjauksia suodattaakseen pois havaintoaikapoikkeamien virheet (vaikka korjaukset sisältävät myös epäjatkuvuuskohtien ja kaupunkisaarekeilmiön korjauksia - lisää NOAA:n korjauksista). Tammikuusta 2000 lähtien NASA oli vahingossa käyttänyt korjaamattomia tietoja.
Usein jätetään huomiotta korjausten koskeneen vain 48 Yhdysvaltain osavaltiota. Koska USA kattaa vain 2% Maapallon pinta-alasta, virheen vaikutus globaaliin trendiin on ollut häviävän pieni.
Alla olevassa kaaviossa (Open Mindin luvalla) verrataan maapallon lämpötilan kehitystä ennen ja jälkeen korjausten. Ennen kuin virhe havaittiin, trendi oli 0,185 °C / vuosikymmen. Korjausten jälkeen se on edelleen 0,185 °C / vuosikymmen. Muutos maailmanlaajuisessa keskiarvossa on alle tuhannesosa asteen."""@fi ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "1934 on tilastojen mukaan lämpimin vuosi USA:ssa, joka kattaa ainoastaan 2 % maapallon pinta-alasta. NASA:n tilastoissa lämpimin vuosi maailmanlaajuisesti on 2005."@fi ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

:claimreview_4e2b962a5e53c8c5619460a5926b389e a schema:ClaimReview ;
    owl:sameAs :claimreview_33a34d26946da0389843775c3dc60f83 ;
    schema:author :person_d84a0115459c73808d005fa082f7e716 ;
    schema:claimReviewed :claimreview_33a34d26946da0389843775c3dc60f83 ;
    schema:headline "Hladen dan v nekem kraju nima nič skupnega z dolgoročnim trendom dvigovanja globalnih temperatur."@sl ;
    schema:inLanguage "Slovenian; Slovene"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Ali hladno vreme spodbija tezo o globalnem segrevanju?"@sl ;
    schema:publisher :organization_sks ;
    schema:reviewBody """Lahko je pomešati dnevne vremenske dogodke z dolgoročnimi podnebnimi trendi in težko je razumeti razliko med vremenom in podnebjem. To  je podobno, kot če skušate, stoječ na obali, ugotoviti ali je plima ali oseka tako, da opazujete posamezne valove, ki se valijo na plažo in se potem umikajo. Počasna sprememba plimovanja je zakrita s stalnim mešanjem valov.
Nenehno spreminjanje vremena na podoben način otežuje opazovanje majhnih sprememb podnebja. Če želite ugotoviti podnebne trende, morate pogledati, kako se vreme spreminja skozi daljša časovna obdobja. Če pogledamo podatke maksimalnih in minimalnih temperatur za zadnja desetletja, vidimo, da se rekordno visoke temperature pojavljajo skoraj dvakrat pogosteje kot rekordno nizke (slika 1).
V bodoče se bodo še pojavljale rekordno nizke temperature, vendar bodo zaradi vpliva globalnega segrevanja postajale vse redkejše."""@sl ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Hladen dan v nekem kraju nima nič skupnega z dolgoročnim trendom dvigovanja globalnih temperatur."@sl ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
    schema:text """Lahko je pomešati dnevne vremenske dogodke z dolgoročnimi podnebnimi trendi in težko je razumeti razliko med vremenom in podnebjem. To  je podobno, kot če skušate, stoječ na obali, ugotoviti ali je plima ali oseka tako, da opazujete posamezne valove, ki se valijo na plažo in se potem umikajo. Počasna sprememba plimovanja je zakrita s stalnim mešanjem valov.
Nenehno spreminjanje vremena na podoben način otežuje opazovanje majhnih sprememb podnebja. Če želite ugotoviti podnebne trende, morate pogledati, kako se vreme spreminja skozi daljša časovna obdobja. Če pogledamo podatke maksimalnih in minimalnih temperatur za zadnja desetletja, vidimo, da se rekordno visoke temperature pojavljajo skoraj dvakrat pogosteje kot rekordno nizke (slika 1).
V bodoče se bodo še pojavljale rekordno nizke temperature, vendar bodo zaradi vpliva globalnega segrevanja postajale vse redkejše."""@sl ;
    schema:url "https://skepticalscience.com/translation.php?a=35&l=22"^^schema:URL .

:claimreview_4e491a3585727764beb2b7de4bdd738d a schema:ClaimReview ;
    owl:sameAs :claimreview_a570e9b2c81bb19471b591a0081489b9 ;
    schema:author :person_f8b116ef68996c37488171cc37ed1567 ;
    schema:claimReviewed :claimreview_a570e9b2c81bb19471b591a0081489b9 ;
    schema:headline "Studi ilmiah telah menentukan bahwa teknologi saat ini sudah cukup untuk mengurangi emisi gas rumah kaca untuk menghindari perubahan iklim yang berbahaya."@id ;
    schema:inLanguage "Indonesian"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Apakah kita bisa memperbaiki pemanasan global?"@id ;
    schema:publisher :organization_sks ;
    schema:reviewBody """Untuk menghindari pemanasan global yang berbahaya, kita perlu mengurangi emisi global gas rumah kaca ( GRK ) sampai sekitar 50% pada tahun 2050. Skeptis sering membuat argumen bahwa kita tidak punya teknologi yang diperlukan untuk mengurangi emisi sebanyak ini dengan cepat.
Pacala dan Socolow (2004) menyelidiki klaim ini dengan memeriksa berbagai teknologi yang tersedia untuk mengurangi emisi gas rumah kaca. Setiap teknologi yang mereka periksa "telah melewati uji coba laboratorium dan proyek percontohan, dan banyak yang sudah dilaksanakan di suatu tempat di skala industri secara penuh." Penelitian ini menggunakan konsep "stabilisasi penunjang", di mana "penunjang menunjukkan kegiatan yang mengurangi emisi ke atmosfer dengan jumlah tertentu. Studi ini mengidentifikasi 15 pilihan mutakhir, yang dapat ditingkatkan untuk menghasilkan setidaknya satu penunjang :
Peningkatan ekonomi bahan bakar
Mengurangi ketergantungan pada mobil
Bangunan yang lebih efisien
Peningkatan efisiensi pembangkit listrik
Mengganti gas alam atas batu bara
Penyimpanan penangkapan karbon pada pembangkit listrik
Penyimpanan penangkapan karbon pada pabrik hidrogen
Penyimpanan penangkapan karbon pada pabrik bahan bakar sintetis
Energi nuklir
Energi angin
Energi surya fotovoltaik
Hidrogen terbarukan
Biofuels
Manajemen hutan
Manajemen lahan pertanian
Ini bukan daftar lengkap, dan ada kemungkinan penunjang-penunjang lain, seperti teknologi energi terbarukan lainnya yang tidak mereka pertimbangkan. Studi ini mencatat bahwa "Setiap salah satu dari pilihan ini sudah diterapkan di skala industri dan dapat ditingkatkan lebih lanjut lebih dari 50 tahun untuk menyediakan setidaknya satu penunjang." Menerapkan suatu tempat antara 7 dan 14 penunjang akan diperlukan untuk menghindari bahaya perubahan iklim .
Intinya adalah bahwa bila pencapaian pengurangan emisi gas rumah kaca yang diperlukan dan stabilisasi penunjang sulit, hal ini mungkin saja terjadi. Namun ada banyak solusi dan kombinasi penunjang yang bisa dipilih."""@id ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Studi ilmiah telah menentukan bahwa teknologi saat ini sudah cukup untuk mengurangi emisi gas rumah kaca untuk menghindari perubahan iklim yang berbahaya."@id ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

:claimreview_4aa3f017daa368cf2fd0f0d46d841047 a schema:ClaimReview ;
    owl:sameAs :claimreview_bb5f69597d1f6eaffb701d8b522dc724 ;
    schema:author :person_cdbcfb10919e9e8b99a1c9b8b21c84bb ;
    schema:claimReviewed :claimreview_bb5f69597d1f6eaffb701d8b522dc724 ;
    schema:headline "Утверждение, что рекордный снегопад несовместим с нагревающейся планетой, демонстрирует недостаточное понимание связи между глобальным потеплением и экстремальными осадками. Потепление приводит к более влажной атмосфере, что в свою очередь ведет к учащению сильных осадков. Включая и сильные снегопады в регионах с подходящими для этого условиями. Отнюдь не в противоречии с глобальным потеплением, рекордные снегопады предсказаны моделями климата и соответствуют нашим ожиданиям увеличения частоты экстремальных осадков."@ru ;
    schema:inLanguage "Russian"^^schema:Text ;
    schema:license "https://creativecommons.org/licenses/by/3.0/"^^schema:URL ;
    schema:name "Рекордные снегопады опровергают глобальное потепление?"@ru ;
    schema:publisher :organization_sks ;
    schema:reviewBody ""@ru ;
    schema:reviewRating [ a schema:Rating ;
            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Утверждение, что рекордный снегопад несовместим с нагревающейся планетой, демонстрирует недостаточное понимание связи между глобальным потеплением и экстремальными осадками. Потепление приводит к более влажной атмосфере, что в свою очередь ведет к учащению сильных осадков. Включая и сильные снегопады в регионах с подходящими для этого условиями. Отнюдь не в противоречии с глобальным потеплением, рекордные снегопады предсказаны моделями климата и соответствуют нашим ожиданиям увеличения частоты экстремальных осадков."@ru ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;

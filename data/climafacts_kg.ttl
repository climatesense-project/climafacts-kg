            schema:bestRating "1"^^schema:Number ;
            schema:name "False"^^schema:Text ;
            schema:ratingExplanation "Arktický mořský led ubýval během posledních třiceti let. Tempo úbytku roste a opravdu přesahuje většinu předpovědí, jak vyplynuly z modelů."@cs ;
            schema:ratingValue "0"^^schema:Number ;
            schema:worstRating "0"^^schema:Number ] ;
